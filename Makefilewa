# Compiler and flags
CXX := g++
CXXFLAGS := \
-std=c++20 -Isrc\
-Idep/include -Ldep/lib -lglfw3dll -lz\
-DGL_API=0

# Directories
SRC_DIR := src
OBJ_DIR := obj
BIN := main

# Find all .cpp files in the src directory
SRCS := $(wildcard src/**/*.cpp) $(wildcard src/*.cpp) $(wildcard src/**/**/*.cpp) $(wildcard src/**/**/**/*.cpp) dep/src/glad.c # $(wildcard $(SRC_DIR)/*.cpp) dep/src/glad.c
# Convert .cpp file names to .o file names in obj directory
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))

# Default target
all: $(BIN)

# Link object files to create the final binary
$(BIN): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^

# Compile .cpp files to .o files
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Clean build files
clean:
	rm -rf $(OBJ_DIR) $(BIN)

.PHONY: all clean